{
  "name": "multica-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Multica platform",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:bootstrap": "cdk bootstrap",
    "deploy:dev": "cdk deploy --all --context environment=dev",
    "deploy:staging": "cdk deploy --all --context environment=staging",
    "deploy:prod": "cdk deploy --all --context environment=prod",
    "destroy:dev": "cdk destroy --all --context environment=dev",
    "destroy:staging": "cdk destroy --all --context environment=staging",
    "destroy:prod": "cdk destroy --all --context environment=prod"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.149.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.149.0",
    "constructs": "^10.3.0"
  }
}
